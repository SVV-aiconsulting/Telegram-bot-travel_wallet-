{
  "__inputs": [
    {
      "name": "DS_LOKI",
      "label": "Loki",
      "type": "datasource",
      "pluginId": "loki"
    }
  ],
  "title": "Travel Wallet Bot — Activity Dashboard",
  "description": "Дашборд логов бота: действия пользователя, системные события и ошибки",
  "tags": ["travel-wallet-bot", "loki", "bot"],
  "timezone": "browser",
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Действия пользователя (1ч)",
      "description": "Добавление расходов и обновления поездок/состояний",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(count_over_time({container=\"travel-wallet-bot\"} |~ \"insert в таблицу expenses|update таблицы trips|update таблицы user_states\" [1h]))"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "fixed", "fixedColor": "blue" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "blue", "value": null }] }
        }
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value"
      }
    },
    {
      "id": 2,
      "title": "Запуски бота (24ч)",
      "description": "Сколько раз бот перезапускался",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(count_over_time({container=\"travel-wallet-bot\"} |= \"Бот запущен\" [24h]))"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "fixed", "fixedColor": "green" }
        }
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value"
      }
    },
    {
      "id": 3,
      "title": "Ошибки (24ч)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(count_over_time({container=\"travel-wallet-bot\"} |~ \" ERROR |exception|ROLLBACK|Таймаут API|Сетевая ошибка\" [24h]))"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "fixed", "fixedColor": "red" }
        }
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value"
      }
    },
    {
      "id": 4,
      "title": "Предупреждения (24ч)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(count_over_time({container=\"travel-wallet-bot\"} |~ \" WARNING \" [24h]))"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "fixed", "fixedColor": "orange" }
        }
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value"
      }
    },
    {
      "id": 5,
      "title": "Активность пользователя (в минуту)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(count_over_time({container=\"travel-wallet-bot\"} |= \"insert в таблицу expenses\" [1m]))",
          "legendFormat": "Добавление расхода"
        },
        {
          "refId": "B",
          "expr": "sum(count_over_time({container=\"travel-wallet-bot\"} |= \"update таблицы trips\" [1m]))",
          "legendFormat": "Обновление поездки"
        },
        {
          "refId": "C",
          "expr": "sum(count_over_time({container=\"travel-wallet-bot\"} |= \"update таблицы user_states\" [1m]))",
          "legendFormat": "Изменение состояния"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 60,
            "lineWidth": 1,
            "showPoints": "never",
            "stacking": { "mode": "none" }
          }
        }
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      }
    },
    {
      "id": 6,
      "title": "Системные события (в минуту)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(count_over_time({container=\"travel-wallet-bot\"} |= \"Бот запущен\" [1m]))",
          "legendFormat": "Запуск бота"
        },
        {
          "refId": "B",
          "expr": "sum(count_over_time({container=\"travel-wallet-bot\"} |= \"Подключение установлено\" [1m]))",
          "legendFormat": "Подключение к БД"
        },
        {
          "refId": "C",
          "expr": "sum(count_over_time({container=\"travel-wallet-bot\"} |= \"валют с API\" [1m]))",
          "legendFormat": "Загрузка валют"
        },
        {
          "refId": "D",
          "expr": "sum(count_over_time({container=\"travel-wallet-bot\"} |~ \"Таймаут API|Сетевая ошибка|WARNING\" [1m]))",
          "legendFormat": "Проблемы API/предупреждения"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 2,
            "showPoints": "auto"
          }
        }
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" }
      }
    },
    {
      "id": 7,
      "title": "Сводка событий за выбранный период",
      "description": "Сколько раз происходило каждое типовое событие",
      "type": "barchart",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 12 },
      "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(count_over_time({container=\"travel-wallet-bot\"} |= \"insert в таблицу expenses\" [$__range]))",
          "legendFormat": "Расходы"
        },
        {
          "refId": "B",
          "expr": "sum(count_over_time({container=\"travel-wallet-bot\"} |= \"update таблицы trips\" [$__range]))",
          "legendFormat": "Поездки"
        },
        {
          "refId": "C",
          "expr": "sum(count_over_time({container=\"travel-wallet-bot\"} |= \"update таблицы user_states\" [$__range]))",
          "legendFormat": "Состояния"
        },
        {
          "refId": "D",
          "expr": "sum(count_over_time({container=\"travel-wallet-bot\"} |= \"Бот запущен\" [$__range]))",
          "legendFormat": "Запуски"
        },
        {
          "refId": "E",
          "expr": "sum(count_over_time({container=\"travel-wallet-bot\"} |= \"Подключение установлено\" [$__range]))",
          "legendFormat": "БД подключена"
        },
        {
          "refId": "F",
          "expr": "sum(count_over_time({container=\"travel-wallet-bot\"} |~ \"ERROR|exception|ROLLBACK|Таймаут API|Сетевая ошибка\" [$__range]))",
          "legendFormat": "Ошибки"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" }
        }
      },
      "options": {
        "orientation": "horizontal",
        "legend": { "displayMode": "list", "placement": "bottom" },
        "xTickLabelRotation": 0,
        "barWidth": 0.8
      }
    },
    {
      "id": 8,
      "title": "Скорость всех логов",
      "type": "timeseries",
      "gridPos": { "h": 6, "w": 24, "x": 0, "y": 20 },
      "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(count_over_time({container=\"travel-wallet-bot\"}[1m]))",
          "legendFormat": "строк/мин"
        }
      ],
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" }
      }
    },
    {
      "id": 9,
      "title": "Действия пользователя (логи)",
      "type": "logs",
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 26 },
      "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
      "targets": [
        {
          "refId": "A",
          "expr": "{container=\"travel-wallet-bot\"} |~ \"insert в таблицу expenses|update таблицы trips|update таблицы user_states|insert в таблицу trips\""
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": false,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "dedupStrategy": "none"
      }
    },
    {
      "id": 10,
      "title": "Системные события (логи)",
      "type": "logs",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 36 },
      "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
      "targets": [
        {
          "refId": "A",
          "expr": "{container=\"travel-wallet-bot\"} |~ \"Бот запущен|Подключение к базе|Подключение установлено|валют с API|Справочник стран|execute_script|VACUUM\""
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": false,
        "wrapLogMessage": true,
        "sortOrder": "Descending"
      }
    },
    {
      "id": 11,
      "title": "Ошибки и предупреждения (логи)",
      "type": "logs",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 44 },
      "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
      "targets": [
        {
          "refId": "A",
          "expr": "{container=\"travel-wallet-bot\"} |~ \"(?i)error|exception|warning|rollback|таймаут api|сетевая ошибка\""
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": false,
        "wrapLogMessage": true,
        "sortOrder": "Descending"
      }
    }
  ],
  "schemaVersion": 39,
  "version": 1
}
