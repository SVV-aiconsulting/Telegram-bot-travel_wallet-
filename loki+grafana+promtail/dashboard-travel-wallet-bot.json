{
  "__inputs": [
    {
      "name": "DS_LOKI",
      "label": "Loki",
      "type": "datasource",
      "pluginId": "loki"
    }
  ],
  "title": "Travel Wallet Bot — Logs",
  "timezone": "browser",
  "refresh": "30s",
  "panels": [
    {
      "id": 1,
      "title": "Всего логов (1ч)",
      "type": "stat",
      "gridPos": {"h": 4, "w": 8, "x": 0, "y": 0},
      "datasource": {"type": "loki", "uid": "${DS_LOKI}"},
      "targets": [{"expr": "sum(count_over_time({container=\"travel-wallet-bot\"}[1h]))", "refId": "A"}]
    },
    {
      "id": 2,
      "title": "Предупреждения (1ч)",
      "type": "stat",
      "gridPos": {"h": 4, "w": 8, "x": 8, "y": 0},
      "datasource": {"type": "loki", "uid": "${DS_LOKI}"},
      "targets": [{"expr": "sum(count_over_time({container=\"travel-wallet-bot\"} |~ \" WARNING \" [1h]))", "refId": "A"}],
      "fieldConfig": {"defaults": {"color": {"mode": "fixed", "fixedColor": "orange"}}}
    },
    {
      "id": 3,
      "title": "Ошибки (1ч)",
      "type": "stat",
      "gridPos": {"h": 4, "w": 8, "x": 16, "y": 0},
      "datasource": {"type": "loki", "uid": "${DS_LOKI}"},
      "targets": [{"expr": "sum(count_over_time({container=\"travel-wallet-bot\"} |~ \" ERROR |exception\" [1h]))", "refId": "A"}],
      "fieldConfig": {"defaults": {"color": {"mode": "fixed", "fixedColor": "red"}}}
    },
    {
      "id": 4,
      "title": "Скорость логов",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 4},
      "datasource": {"type": "loki", "uid": "${DS_LOKI}"},
      "targets": [{"expr": "sum(count_over_time({container=\"travel-wallet-bot\"}[1m]))", "legendFormat": "logs/min", "refId": "A"}]
    },
    {
      "id": 5,
      "title": "Операции с БД",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 12},
      "datasource": {"type": "loki", "uid": "${DS_LOKI}"},
      "targets": [
        {"expr": "sum(count_over_time({container=\"travel-wallet-bot\"} |= \"insert в таблицу\" [1m]))", "legendFormat": "insert", "refId": "A"},
        {"expr": "sum(count_over_time({container=\"travel-wallet-bot\"} |= \"update таблицы\" [1m]))", "legendFormat": "update", "refId": "B"},
        {"expr": "sum(count_over_time({container=\"travel-wallet-bot\"} |= \"delete из\" [1m]))", "legendFormat": "delete", "refId": "C"}
      ]
    },
    {
      "id": 6,
      "title": "Уровни логов",
      "type": "piechart",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 12},
      "datasource": {"type": "loki", "uid": "${DS_LOKI}"},
      "targets": [
        {"expr": "sum(count_over_time({container=\"travel-wallet-bot\"} |~ \" INFO \" [24h]))", "legendFormat": "INFO", "refId": "A"},
        {"expr": "sum(count_over_time({container=\"travel-wallet-bot\"} |~ \" WARNING \" [24h]))", "legendFormat": "WARNING", "refId": "B"},
        {"expr": "sum(count_over_time({container=\"travel-wallet-bot\"} |~ \" ERROR \" [24h]))", "legendFormat": "ERROR", "refId": "C"}
      ]
    },
    {
      "id": 7,
      "title": "Все логи бота",
      "type": "logs",
      "gridPos": {"h": 10, "w": 24, "x": 0, "y": 20},
      "datasource": {"type": "loki", "uid": "${DS_LOKI}"},
      "targets": [{"expr": "{container=\"travel-wallet-bot\"}", "refId": "A"}],
      "options": {"showTime": true, "showLabels": false, "sortOrder": "Descending"}
    },
    {
      "id": 8,
      "title": "Ошибки и исключения",
      "type": "logs",
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 30},
      "datasource": {"type": "loki", "uid": "${DS_LOKI}"},
      "targets": [{"expr": "{container=\"travel-wallet-bot\"} |~ \"(?i)error|exception|rollback\"", "refId": "A"}],
      "options": {"showTime": true, "sortOrder": "Descending"}
    }
  ],
  "schemaVersion": 39,
  "version": 1
}
